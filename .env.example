NODE_ENV=development
PORT=4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
DATABASE_URL=postgresql://patima_app:replace-with-db-password@localhost:5432/patima_naver_ss
MASTER_KEY=replace-with-32-byte-secret
DATA_DIR=./apps/backend/data
UPLOAD_DIR=./apps/backend/uploads
ORDER_RAW_PAYLOAD_RETENTION_DAYS=90
NAVER_BOOTSTRAP_STORE=false
NAVER_STORE_NAME=replace-with-store-name
NAVER_SOLUTION_ID=replace-with-solution-id
NAVER_CLIENT_ID=replace-with-solution-app-id
NAVER_CLIENT_SECRET=replace-with-solution-app-secret
NAVER_ACCOUNT_UID=replace-with-account-uid
NAVER_CHANNEL_NO=replace-with-channel-no
NAVER_CALLBACK_URL=https://replace-with-public-callback-host/naver/callback
